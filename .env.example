# Required: path token for /api/mcp/<token>. Generate with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Must be at least 32 characters. Never commit the real value.
GSD_MCP_TOKEN=

# Absolute ceiling for a single expense amount (default 10000).
GSD_MAX_EXPENSE_AMOUNT=10000

# stub = in-memory echo (default). http = call FINANCE_API_URL.
FINANCE_MODE=stub

# Required when FINANCE_MODE=http
FINANCE_API_URL=https://finance.davy.build/api/
FINANCE_API_KEY=
