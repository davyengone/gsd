# Private 32+ character token for MCP and dashboard login.
GSD_MCP_TOKEN=

# Dedicated MongoDB URI and database for this GSD app.
MONGODB_URI=
MONGODB_DB=gsd

# Anthropic provider key. Without it GSD tries Anthropic through Vercel AI Gateway.
ANTHROPIC_API_KEY=
GSD_EXTRACTION_MODEL=claude-sonnet-4-6
